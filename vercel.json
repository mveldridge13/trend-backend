{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npx prisma generate && npm run build && mkdir -p public && printf 'User-agent: *\\nDisallow: /\\n' > public/robots.txt",
  "outputDirectory": "public",
  "regions": ["syd1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
